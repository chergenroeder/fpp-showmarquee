{
    "global": {
        "schema_version": 1,
        "enable_output": true,
        "fpp_host": "localhost",
        "fps": 20
    },
    "countdown": {
        "enabled": true,
        "model": "",
        "target": {
            "type": "christmas",
            "custom_date": "",
            "custom_time": "00:00",
            "custom_repeat_yearly": false,
            "event_name": {
                "custom": "My Event",
                "christmas": "Christmas",
                "newyear": "New Year's Day"
            }
        },
        "layout": {
            "number_position": "first",
            "connector_first": "to",
            "connector_last": "in",
            "units": {
                "day": "Day", "days": "Days",
                "hour": "Hour", "hours": "Hours",
                "minute": "Minute", "minutes": "Minutes"
            },
            "under_one_day": "hms"
        },
        "motion": {
            "direction": "R2L",
            "pixels_per_second": 15,
            "repeat_delay": 0,
            "static_hold": 5
        },
        "text_style":   { "font": "DejaVuSans-Bold", "size": 10, "color": "#ff0000", "antialias": false },
        "number_style": { "font": "DejaVuSans-Bold", "size": 10, "color": "#00ff00", "antialias": false }
    },
    "weather": {
        "enabled": false,
        "port": 50222,
        "device": "",
        "stale_minutes": 5,
        "temperature": { "enabled": true, "label": "Temp" },
        "wind": {
            "enabled": true, "label": "Wind", "direction": true,
            "gusts": true, "gust_label": "gusts", "gust_min_diff_mph": 5, "calm_text": "Calm"
        }
    }
}
