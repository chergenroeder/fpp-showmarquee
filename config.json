{
    "global": {
        "schema_version": 1,
        "enable_output": true,
        "fpp_host": "localhost",
        "fps": 20,
        "screen_seconds": 5,
        "page_order": ["countdown", "weather", "social", "showprep", "schedule", "messages"]
    },
    "countdown": {
        "enabled": true,
        "model": "",
        "target": {
            "type": "christmas",
            "custom_date": "",
            "custom_time": "00:00",
            "custom_repeat_yearly": false,
            "event_name": {
                "custom": "My Event",
                "christmas": "Christmas",
                "newyear": "New Year's Day"
            }
        },
        "layout": {
            "number_position": "first",
            "connector_first": "to",
            "connector_last": "in",
            "units": {
                "day": "Day", "days": "Days",
                "hour": "Hour", "hours": "Hours",
                "minute": "Minute", "minutes": "Minutes"
            },
            "under_one_day": "hms"
        },
        "text_style":   { "font": "DejaVuSans-Bold", "size": 10, "color": "#ff0000", "antialias": false },
        "number_style": { "font": "DejaVuSans-Bold", "size": 10, "color": "#00ff00", "antialias": false }
    },
    "weather": {
        "enabled": false,
        "source": "",
        "open_meteo": { "use_fpp_location": true },
        "port": 50222,
        "device": "",
        "stale_minutes": 5,
        "temperature": { "enabled": true },
        "wind": {
            "enabled": true, "label": "Wind", "direction": true,
            "gusts": true, "gust_label": "gusts", "gust_min_diff_mph": 5, "calm_text": "Calm"
        },
        "symbol": { "wind_mph": 15, "gust_mph": 25 }
    },
    "social": {
        "enabled": false,
        "sites": {
            "facebook":  { "enabled": false, "handle": "" },
            "instagram": { "enabled": false, "handle": "" },
            "tiktok":    { "enabled": false, "handle": "" },
            "youtube":   { "enabled": false, "handle": "" }
        }
    },
    "showprep": {
        "enabled": false,
        "app": "",
        "message": "Scan to get the {app} app before the show",
        "link": ""
    },
    "schedule": {
        "enabled": false,
        "nights": [true, true, true, true, true, true, true],
        "mode": "same",
        "every": { "start": "17:30", "end": "22:00" },
        "weekend_nights": [false, false, false, false, false, true, true],
        "weeknight": { "start": "17:30", "end": "22:00" },
        "weekend": { "start": "17:30", "end": "23:00" },
        "custom": [
            { "start": "17:30", "end": "22:00" }, { "start": "17:30", "end": "22:00" },
            { "start": "17:30", "end": "22:00" }, { "start": "17:30", "end": "22:00" },
            { "start": "17:30", "end": "22:00" }, { "start": "17:30", "end": "23:00" },
            { "start": "17:30", "end": "23:00" }
        ],
        "show": "week",
        "title": "Show Times",
        "clock": "12"
    },
    "messages": {
        "enabled": false,
        "items": []
    }
}
