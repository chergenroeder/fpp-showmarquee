{
    "global": {
        "schema_version": 1,
        "enable_output": true,
        "fpp_host": "localhost",
        "fps": 20,
        "screen_seconds": 5
    },
    "countdown": {
        "enabled": true,
        "model": "",
        "target": {
            "type": "christmas",
            "custom_date": "",
            "custom_time": "00:00",
            "custom_repeat_yearly": false,
            "event_name": {
                "custom": "My Event",
                "christmas": "Christmas",
                "newyear": "New Year's Day"
            }
        },
        "layout": {
            "number_position": "first",
            "connector_first": "to",
            "connector_last": "in",
            "units": {
                "day": "Day", "days": "Days",
                "hour": "Hour", "hours": "Hours",
                "minute": "Minute", "minutes": "Minutes"
            },
            "under_one_day": "hms"
        },
        "text_style":   { "font": "DejaVuSans-Bold", "size": 10, "color": "#ff0000", "antialias": false },
        "number_style": { "font": "DejaVuSans-Bold", "size": 10, "color": "#00ff00", "antialias": false }
    },
    "weather": {
        "enabled": false,
        "source": "",
        "open_meteo": { "use_fpp_location": true },
        "port": 50222,
        "device": "",
        "stale_minutes": 5,
        "temperature": { "enabled": true },
        "wind": {
            "enabled": true, "direction": true,
            "gusts": true, "gust_label": "gusts", "gust_min_diff_mph": 5, "calm_text": "Calm"
        },
        "symbol": { "wind_mph": 15, "gust_mph": 25 }
    },
    "social": {
        "enabled": false,
        "sites": {
            "facebook":  { "enabled": false, "handle": "" },
            "instagram": { "enabled": false, "handle": "" },
            "tiktok":    { "enabled": false, "handle": "" },
            "youtube":   { "enabled": false, "handle": "" }
        }
    }
}
